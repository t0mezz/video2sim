# Copy to .env and fill in. Never commit .env.
# These names are this project's convention, not taken from any provider's documentation.

# Key for the Meta Model API (hosted SAM 3.1, optionally the material-inference model).
# Leave empty if SAM 3.1 is self-hosted. See PLAN.md decision D-004.
META_MODEL_API_KEY=

# Key for the hosted vision-language model on Baseten: material class and mass (D-017, D-024).
BASETEN_API_KEY=

# Where large artifacts live on this machine. Defaults to ./data and ./runs.
VIDEO2SIM_DATA_DIR=
VIDEO2SIM_RUNS_DIR=
